.env
.env.local
.env.development
.env.production
.env.staging
*.env

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
dist/
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.nyc_output/

# ── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Secrets / Keys ──────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
secrets/
credentials/

# ── Upload / temp files ─────────────────────────────────────
uploads/
tmp/
temp/
*.tmp

# ── Supabase local ──────────────────────────────────────────
.supabase/

